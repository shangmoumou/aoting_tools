@echo off
chcp 936 >nul 2>nul
setlocal
cd /d "%~dp0\.."

rem ===================================================================
rem  环境自检 —— 当 start_aoting_tools.bat 报错时，跑这个并把结果
rem  整段复制给工具箱维护者，能一次定位。
rem
rem  它回答三个问题：
rem    1. 这台电脑上到底有没有能用的 Python？
rem    2. 如果没有，是"完全没装"还是"装了但检测不到"？
rem    3. 端口 8899 是不是被别的东西占了？
rem ===================================================================

echo.
echo ==================================================================
echo   哈工澳汀调试工具箱 - 环境自检
echo ==================================================================
echo.
echo   目录: %CD%
echo   时间: %DATE% %TIME%
echo   系统: %OS%  /  %PROCESSOR_ARCHITECTURE%
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [1] where 查到的 python（可能有多个，也可能只有商店占位程序）
echo ------------------------------------------------------------------
where python 2>nul
if errorlevel 1 echo     （where python 没有结果）
echo.
where py 2>nul
if errorlevel 1 echo     （where py 没有结果）
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [2] 逐个真实执行一遍（能跑出版本号的才算数）
echo ------------------------------------------------------------------
echo.
echo --- python --version
python --version 2>&1
echo     退出码 = %ERRORLEVEL%
echo.
echo --- py --version
py --version 2>&1
echo     退出码 = %ERRORLEVEL%
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [3] 默认安装位置扫描
echo ------------------------------------------------------------------
for /D %%D in ("%LOCALAPPDATA%\Programs\Python\Python3*") do (
  echo     发现: %%D
  "%%D\python.exe" --version 2>&1
)
for /D %%D in ("%ProgramFiles%\Python3*") do (
  echo     发现: %%D
  "%%D\python.exe" --version 2>&1
)
for /D %%D in ("C:\Python3*") do (
  echo     发现: %%D
  "%%D\python.exe" --version 2>&1
)
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [4] 商店占位程序（它"存在"但一跑就报错，是 9009 的常见原因）
echo ------------------------------------------------------------------
if exist "%LOCALAPPDATA%\Microsoft\WindowsApps\python.exe" (
  echo     [存在] %LOCALAPPDATA%\Microsoft\WindowsApps\python.exe
  echo            这就是占位程序。它不算"装了 Python"。
) else (
  echo     未发现占位程序。
)
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [5] 端口 8899 占用情况
echo ------------------------------------------------------------------
netstat -ano | findstr ":8899"
if errorlevel 1 echo     8899 当前没有被占用（正常）。
echo.

rem ------------------------------------------------------------------
echo ------------------------------------------------------------------
echo [6] 关键文件是否齐全
echo ------------------------------------------------------------------
for %%F in (portal_server.py index.html version.json portal.json) do (
  if exist "%%F" (echo     [OK]   %%F) else (echo     [缺失] %%F)
)
echo.
if exist "tools\gate_token.txt" (
  echo     [OK]   tools\gate_token.txt（账号服务器令牌已放好）
) else (
  echo     [缺]   tools\gate_token.txt —— 没有它，相机卡片解锁会失败
)
echo.

echo ==================================================================
echo   自检结束。请把上面整段复制到发给维护者。
echo ==================================================================
echo.
pause
